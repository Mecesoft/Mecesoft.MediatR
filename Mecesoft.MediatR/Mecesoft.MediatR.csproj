<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Title>Mecesoft.MediatR</Title>
        <Description>A lightweight, dependency-injection-friendly mediator library for .NET.</Description>
        <PackageId>Mecesoft.MediatR</PackageId>
        <Authors>Mecesoft</Authors>
        <Copyright>Copyright © Mecesoft</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Mecesoft/Mecesoft.MediatR</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Mecesoft/Mecesoft.MediatR</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>mediator;mediatr;dependency-injection;pipeline</PackageTags>
        <Version>1.1.0</Version>
        <PackageIcon>Mecesoft_MediatR_Logo.png</PackageIcon>
        <PackageReleaseNotes>
            Added support for .NET 8 and .NET 10.
            Optimized request dispatch performance and reduced allocations.
            Improved pipeline execution with lazy handler resolution.
            Preserved backward-compatible concurrent notification publishing.
            Added regression tests and improved documentation.
        </PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Mecesoft_MediatR_Logo.png" Pack="true" PackagePath="\" />
      <None Include="..\README.md" Pack="true" PackagePath="\" />
      <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
